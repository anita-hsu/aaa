            "71323": { name: "立可帶", status: "已歸還", color: "green" }
        };

        // 修正後的「尋找進度」查詢邏輯
        function checkItemStatus() {
            const codeInput = document.getElementById('query-code').value.trim();
            const resultDiv = document.getElementById('status-result-display');
            
            if(!codeInput) {
                alert('請輸入物品編號！');
                return;
            }

            resultDiv.style.display = 'block'; // 顯示區塊

            if(mockDatabase[codeInput]) {
                const item = mockDatabase[codeInput];
                resultDiv.innerHTML = `
                    <strong style="color: #333;">編號：${codeInput}</strong><br>
                    <span style="font-size:12px; color:#666;">項目：${item.name}</span><br>
                    <span style="font-weight:bold; color:${item.color};">狀態：${item.status}</span>
                `;
            } else {
                resultDiv.innerHTML = `<span style="color:red; font-weight:bold;">⚠️ 查無此編號</span>`;
            }
        }

        // 頁面切換邏輯
        function switchPage(pageId) {
            const pages = document.querySelectorAll('.page');
            pages.forEach(page => page.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');

            const menuItems = document.querySelectorAll('.sidebar-menu li');
            menuItems.forEach((item, index) => {
                item.classList.remove('active');
                if(`page${index+1}` === pageId) {
                    item.classList.add('active');
                }
            });
        }

        // 彈出提示邏輯
        function showPopup(type) {
            const popup = document.getElementById('status-popup');
            const msgs = document.querySelectorAll('.pop-msg');
            
            popup.style.display = 'block';
            msgs.forEach(msg => msg.style.display = 'none');
            
            if (type === 'found') {
                document.getElementById('pop-content-found').style.display = 'block';
            } else if (type === 'none') {
                document.getElementById('pop-content-none').style.display = 'block';
            } else {
                alert('開啟該項目的詳細資料比對頁面');
                popup.style.display = 'none';
            }
        }
    </script>
</body>
</html>
